' ============================================================
' MyHomePlus 架构图共享样式
' 只放视觉约定，不放业务语义；所有 .puml 通过 !include 引用。
' 颜色语义见 README「图例」。
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 13
skinparam titleFontSize 20
skinparam captionFontSize 12
skinparam roundcorner 10
skinparam nodesep 38
skinparam ranksep 42
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 11
skinparam ArrowFontName "Noto Sans CJK SC"

' ---- 通用元素 ----
skinparam actor {
  BackgroundColor #E2E8F0
  BorderColor #334155
  FontColor #0F172A
}
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #0F172A
}
skinparam queue {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #0F172A
}
skinparam cloud {
  BackgroundColor #F5F3FF
  BorderColor #7E22CE
  FontColor #0F172A
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
}
skinparam folder {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
  ArrowColor #475569
}
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
  ArrowColor #475569
}

