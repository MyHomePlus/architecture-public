  FontColor #0F172A
}
skinparam component<<approved>> {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  FontColor #0F172A
}

' ---- 语义化 stereotype：数据 ----
skinparam database<<resource>> {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam database<<intake>> {
  BackgroundColor #FFEDD5
  BorderColor #C2410C
}
skinparam database<<knowledge>> {
  BackgroundColor #E0F2FE
