}
skinparam component<<agent>> {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  FontColor #0F172A
}
skinparam component<<entry>> {
  BackgroundColor #D1FAE5
  BorderColor #047857
  FontColor #0F172A
}
skinparam component<<infra>> {
  BackgroundColor #E2E8F0
  BorderColor #475569
  FontColor #0F172A
}
skinparam component<<external>> {
  BackgroundColor #F3E8FF
  BorderColor #7E22CE
  FontColor #0F172A
}
skinparam component<<readonly>> {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
  FontColor #0F172A
}
skinparam component<<danger>> {
  BackgroundColor #FEE2E2
