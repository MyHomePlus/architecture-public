  ParticipantFontColor #0F172A
  ActorBackgroundColor #E2E8F0
  ActorBorderColor #334155
  GroupBackgroundColor #F1F5F9
  GroupBorderColor #CBD5E1
  NoteBackgroundColor #FEF9C3
  NoteBorderColor #CA8A04
  DividerBackgroundColor #E2E8F0
  DividerBorderColor #94A3B8
}

' ---- 图注 ----
skinparam legend {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  FontSize 11
}
