@startuml
!include includes/style.puml
allow_mixing

title home-ai · 领域助手、技能与能力
caption 目标结构：每个助手只拥有本域技能；助手之间不互调；能力基座共享。

package "home-ai（FastAPI）" as AIPkg {
  package "领域助手（目标）" {
    component "库存助手\ninventory" as A1 <<entry>>
    component "吃饭助手\nmeal" as A2 <<entry>>
    component "采购助手\nshopping" as A3 <<entry>>
    component "提醒助手\nreminder" as A4 <<entry>>
    A1 -[hidden]right-> A2
    A2 -[hidden]right-> A3
    A3 -[hidden]right-> A4
  }

  package "生活技能（每个只属于一个助手）" {
    component "capture_inventory" as S1 <<agent>>
    component "plan_week_menu" as S2 <<agent>>
    component "replenish_shopping" as S3 <<agent>>
    component "remind" as S4 <<agent>>
    S1 -[hidden]right-> S2
    S2 -[hidden]right-> S3
    S3 -[hidden]right-> S4
  }

  component "tools\n唯一业务桥\n白名单 / 风险 / 幂等" as Tools <<agent>>
  component "intake\n当前输入适配\n上传 · OCR/ASR · 草稿" as Intake <<service>>
  component "knowledge\n单域检索（以后）" as Knowledge <<readonly>>
  component "platform\nperception · llm · storage · jobs · notify" as Platform <<infra>>
  component "core_client\nhome-core API 客户端" as CoreClient <<infra>>
}

component "home-core API\n业务真相源" as CoreAPI <<service>>

A1 --> S1
A2 --> S2
A3 --> S3
A4 --> S4
S1 --> Tools
S2 --> Tools
S3 --> Tools
S4 --> Tools
Tools --> CoreClient : 读 / 提案
Tools --> Intake : 当前感知
Tools --> Knowledge : 以后
Intake --> Platform
Knowledge --> Platform
S2 --> Platform : llm 可选
S3 --> Platform : rules / jobs
S4 --> Platform : scheduler / notify
CoreClient --> CoreAPI : HTTP

note bottom of AIPkg
  **边界**
  · 助手之间没有箭头：不互调、不共享会话/上下文/工具白名单
  · 跨域数据通过 core public read service 获取；写只写自己业务域
  · tools 是唯一业务桥；AI 只提案，确认后经 core API 执行
  · 当前实际代码只有 intake + platform/perception；助手/skills 是目标层
end note

@enduml
